{
  "name": "special-minds-community",
  "version": "0.1.0",
  "private": true,
  "description": "Special Minds Community: one place for Special Minds specialists and families, run by Special Minds. Channels, opportunities, a parents' feed, events and full admin control.",
  "scripts": {
    "dev": "next dev -p 4810",
    "build": "next build",
    "start": "next start -p 4810",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node scripts/db.mjs migrate",
    "db:reset": "node scripts/db.mjs reset",
    "db:seed": "node scripts/db.mjs seed",
    "member:add": "node scripts/db.mjs add-owner",
    "i18n:check": "node scripts/i18n-check.mjs",
    "talent:mock": "node scripts/talent-mock.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.9",
    "libphonenumber-js": "1.13.15",
    "lucide-react": "1.57.0",
    "next": "16.4.1",
    "postgres": "3.4.9",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/web-push": "3.6.4",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  }
