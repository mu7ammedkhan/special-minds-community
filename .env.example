# Copy to .env.local on a laptop, or set these on the host (Vercel → Settings → Environment Variables).

# Database. Leave unset on a laptop (a local PGlite database under .data/).
# Live: its own Postgres (a new Supabase project or Neon), e.g. postgres://…?sslmode=require
# DATABASE_URL=pglite://.data/pglite
# DATABASE_POOL_MAX=5

# This app's own address, for links in emails, WhatsApp messages and calendar files.
APP_URL=http://localhost:4810
NEXT_PUBLIC_APP_TIMEZONE=Asia/Dubai

# Demo data only: list the made-up accounts on the sign-in page, and show sign-in codes on screen.
# Never on real data.
# DEMO_LOGINS=1
# SHOW_CODES=1

# Pop-up notifications: make the pair with `node scripts/vapid.mjs .env.local` (once per place).
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:hello@specialminds.ae

# Email (sign-in codes, invites, unread announcements, digests): Resend.
# RESEND_API_KEY=
# EMAIL_FROM=Special Minds Community <community@specialminds.ae>

# WhatsApp (codes to phones, nudges, urgent broadcasts): Meta's WhatsApp Cloud API, with one approved template per use.
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_TEMPLATE_LOGIN_CODE=
# WHATSAPP_TEMPLATE_OPPORTUNITY=
# WHATSAPP_TEMPLATE_BROADCAST=
# WHATSAPP_TEMPLATE_UPDATE=

# "Ask Special Minds for help" → a lead in the CRM (the same contract as the websites).
# CRM_INTAKE_URL=https://crm.specialminds.app/api/intake/website
# CRM_INTAKE_KEY=
# CRM_SOURCE_SITE=specialminds-ae

# Opportunity shortlists → the Talent portal (its receiving side isn't built yet), and profile links.
# TALENT_URL=https://talent.specialminds.app
# TALENT_SHORTLIST_URL=
# TALENT_SHORTLIST_SECRET=

# A scheduler (cron-job.org, GitHub Actions, Vercel Cron on Pro) calling GET /api/cron/tick with
# "Authorization: Bearer <CRON_SECRET>" every minute makes scheduled posts and reminders exact even
# when nobody has the community open.
# CRON_SECRET=
